<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#F8F9FA">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Selector de Mapas"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#1E293B"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Selecciona el proveedor de mapas para visualizar las alertas"
        android:textSize="14sp"
        android:textColor="#64748B"
        android:textAlignment="center"
        android:layout_marginBottom="36dp" />

    <!-- Botón OpenStreetMap -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnOpenStreetMap"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="OpenStreetMap (OSMDroid)"
        android:textSize="14sp"
        app:cornerRadius="16dp"
        app:icon="@android:drawable/ic_dialog_map"
        app:iconGravity="textStart"
        android:layout_marginBottom="16dp" />

    <!-- Botón Google Maps -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnGoogleMaps"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Google Maps SDK"
        android:textSize="14sp"
        android:textColor="#2563EB"
        app:strokeColor="#2563EB"
        app:cornerRadius="16dp"
        app:icon="@android:drawable/ic_menu_myplaces"
        app:iconTint="#2563EB"
        app:iconGravity="textStart" />

</LinearLayout>